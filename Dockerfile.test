FROM node:18-bullseye

# Instalar Python 3 e tzdata
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3 python3-pip tzdata python-is-python3 && \
    rm -rf /var/lib/apt/lists/*

# Instalar o Google Workspace CLI globalmente como no workflow do github
RUN npm install -g @googleworkspace/cli || true
# Nota: se o npm package se chamar diferente do que estÃ¡ no workflow, vocÃª pode ajustar aqui.

WORKDIR /app

# Copiar os arquivos do repositÃ³rio
COPY . .

# Instalar as dependÃªncias Python do workflow
RUN pip install --upgrade pip
RUN pip install python-dotenv pytz

# Configurar as variÃ¡veis de ambiente do GitHub Actions
ENV FORCE_JAVASCRIPT_ACTIONS_TO_NODE24="true"
ENV GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE="credenciais_cmd_un_gws.json"
ENV GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND="file"
ENV PYTHONPATH=".:agents/morning-email-triage/execution:agents/daily-standup-generator/execution:agents/morning-briefing-ui/execution"

# O comando padrÃ£o executa o workflow
CMD ["python", "run_routine.py"]
